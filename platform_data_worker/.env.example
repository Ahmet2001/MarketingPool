# Same Supabase project as social-media-worker / marketing-agent (platform_data_jobs table).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Where the toolbox manifests + api/toolbox.py modules live. Defaults to ../toolboxes.
TOOLBOXES_DIR=
PLATFORM_DATA_POLL_MS=5000
# Largest result (bytes of JSON) written back to the job row; bigger results are shrunk.
PLATFORM_DATA_MAX_RESULT_BYTES=200000

# Platform credentials -- ONLY this process holds them; the agent never sees them.
# Configure just the platforms you collect from; the exact names each toolbox
# reads are `required_env` / `optional_*_env` in toolboxes/<platform>/manifest.yaml.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
TIKTOK_ACCESS_TOKEN=
X_API_BEARER_TOKEN=
REDDIT_USER_AGENT=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
