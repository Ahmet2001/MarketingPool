# ---- Model: DeepSeek (OpenAI-compatible API) ----
# For a provider other than gemini or moonshot, the agent reads the key from <PROVIDER>_API_KEY, so a
# provider named "deepseek" uses DEEPSEEK_API_KEY (or MODEL_API_KEY for any provider).
MODEL_PROVIDER=deepseek
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Check the current names in DeepSeek's docs; "deepseek-chat" is the general model,
# "deepseek-reasoner" the reasoning one.
BASE_MODEL_NAME=deepseek-chat
SUBMODEL_MODEL_NAME=deepseek-chat
BROWSER_AGENT_MODEL=deepseek-chat
TOOL_GENERATOR_MODEL=deepseek-chat
# Left empty on purpose: reasoning_effort is a Gemini parameter and is only sent when set.
BASE_REASONING_EFFORT=
SUBMODEL_REASONING_EFFORT=
BROWSER_REASONING_EFFORT=
# NOT a real key. Three sub-agents (research, system, vision) build a Gemini client when the agent
# starts, even though they are inactive, and crash without a value. Replace it only if you enable them.
GEMINI_API_KEY=unused-placeholder

BROWSER_ACTION_DELAY_SCALE=0.4

# TELEGRAM_TOKEN is set by docker-compose or not needed here
GEMINI_API_KEY_SECONDARY=
# DISCORD_TOKEN is set by docker-compose or not needed here
# HEARTBEAT_CHAT_ID is set by docker-compose or not needed here
PEXELS_API_KEY=

# social-media-worker'in kullandigi AYNI Supabase projesi (publish_jobs kuyrugu,
# artik agent_jobs kuyrugu da — bkz. MarketingApp/worker.py)
# SUPABASE_URL is set by docker-compose or not needed here
# Tercih edilen: publish_jobs/agent_jobs'a SADECE insert+select (agent_jobs icin
# +update) yapabilen, daraltilmis bir role'e bagli anahtar. Bu role'u/anahtari
# nasil olusturacagini gorene kadar bos birak — SUPABASE_SECRET_KEY'e dusulur
# (bkz. migrations/002_*_idempotency_key.sql'deki ornek GRANT/POLICY ve
# AGENT.md "Supabase anahtarini daraltma").
# SUPABASE_AGENT_KEY is set by docker-compose or not needed here
# Service-role (tam yetki, RLS bypass) -- SUPABASE_AGENT_KEY tanimli degilse
# kullanilir. En az bir tanesi zorunlu.
# SUPABASE_SECRET_KEY is set by docker-compose or not needed here

# Herhangi bir App'in onayli asset havuzu (future_work.md "collect_assets").
# Sozlesme + kendi App'ini baglamak icin kit: ../../asset-pool/README.md
# (ornek: asset-pool/examples/karatahta). Bos birakilirsa asset_collector_agent
# net bir yapilandirma hatasi dondurur, sessizce basarisiz olmaz.
APP_INTERNAL_URL=
APP_INTERNAL_TOKEN=
# Havuz App'te /api/assets'ten farkli bir yola mount edildiyse.
APP_ASSETS_PATH=/api/assets
# App'in video uretim endpoint'i (opsiyonel; App bunu uygulamiyorsa
# video_uretimi_iste net bir hata dondurur). Bkz. asset-pool/README.md.
APP_VIDEO_REQUESTS_PATH=/api/video-requests
# medya_dogrula/medya_hazirla'nin dogruladigi video URL'leri icin izin verilen
# host listesi (social-media-worker'in ALLOWED_VIDEO_HOSTS'uyla AYNI degisken
# adi ve anlami — bos = tum https host'lara izin ver).
ALLOWED_VIDEO_HOSTS=

# video_uretimi_iste onay ister (varsayilan) ve gunluk sinir uygular (ucretli/
# geri alinamaz olabilecegi icin). Bassiz bir worker'in kendi onay akisini
# baglayana kadar false yapmayin.
VIDEO_GENERATION_REQUIRES_APPROVAL=true
VIDEO_GENERATION_MAX_PER_DAY=3

# platform_veri_topla/durumu icin kuyruk (../../platform_data_worker/README.md).
# Ayni SUPABASE_URL/SUPABASE_AGENT_KEY/SUPABASE_SECRET_KEY kullanilir (yukarida);
# platform_data_worker KENDI .env'inde ayrica platform kimlik bilgilerini tutar
# -- bu ajan onlari hic gormez. TOOLBOXES_DIR sadece repo disina tasindiysa gerekir.
TOOLBOXES_DIR=

# MarketingApp/worker.py ("python -m MarketingApp.worker") -- Ethgent'i insansiz
# calisan bir worker olarak baslatir: agent_jobs Supabase kuyrugunu (bkz.
# migrations/001_agent_jobs.sql; ayni SUPABASE_URL/SUPABASE_SECRET_KEY) yoklar
# VE ayni anda bir MCP sunucusu (POST /mcp) acar. Terminal (main.py) ile ayni
# workspace_dir'e karsi ES ZAMANLI calistirilmasi desteklenmez (bkz. worker.py
# modul docstring'i).
AGENT_WORKER_POLL_MS=4000
AGENT_WORKER_MCP_HOST=127.0.0.1
AGENT_WORKER_MCP_PORT=8091
# Zorunlu: bos birakilirsa MCP sunucusu ayaktadir ama TUM istekleri 500 ile
# reddeder (mcp_worker/.env.example ile ayni davranis). Client bunu
# `Authorization: Bearer <token>` olarak gondermeli.
AGENT_WORKER_MCP_TOKEN=
# run_marketing_task bir gorevi en fazla bu kadar (ms) senkron bekler; asilirsa
# {status:"running", jobId} doner ve gorev arka planda calismaya devam eder --
# check_marketing_task(job_id) ile sonradan sorgulanir.
AGENT_WORKER_WAIT_MS=45000
